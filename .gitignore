# Local secrets - never commit (Plan 58 OAuth credentials, refresh tokens)
/secrets/

# Syncthing conflict copies - never commit, never track
*.sync-conflict-*

# Local agent/tool settings
.claude/

# Temporary work folders (archived externally, not part of the site)
scratch/
temp_archive/

# Credential files - defensive, must never enter git
**/cloudflare_Token.md

# Plan 59 — independent build output directory (Cloudflare build target), generated
# only, never committed. Self-excluded from its own copy source (D07).
/dist/
